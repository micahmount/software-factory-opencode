#!/usr/bin/env python3
"""Create or update the GitHub labels the factory relies on.

Usage:
  labels [OWNER/REPO]

With no argument, gh uses the repository in the current directory. Run this
once per project after installing the factory.
"""

import json
import subprocess
import sys
from pathlib import Path

FACTORY = Path(__file__).resolve().parent
CONFIG = json.loads((FACTORY / "config.json").read_text())

LABELS = {
    "queue": ("Execute a job with the software factory", "1D76DB"),
    "needs_info": ("Factory is waiting for the issue author", "FBCA04"),
    "needs_human": ("Factory needs a human decision or merge", "B60205"),
}


def die(msg):
    print(f"labels: {msg}", file=sys.stderr)
    sys.exit(1)


def main(argv):
    if len(argv) > 1:
        die(__doc__.strip())
    repo = ["--repo", argv[0]] if argv else []
    for key, (description, color) in LABELS.items():
        name = CONFIG["labels"][key]
        cmd = ["gh", "label", "create", name, "--description", description,
               "--color", color, "--force", *repo]
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode:
            die(f"could not create {name}: {(res.stderr or res.stdout).strip()}")
        print(name)


if __name__ == "__main__":
    main(sys.argv[1:])
