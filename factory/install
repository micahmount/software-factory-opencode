#!/usr/bin/env python3
"""Drop the OpenCode factory into another project checkout.

Usage:
  factory/install [--force] <project-directory>

Copies the harness-neutral factory (scripts, gate, config, dashboard) and the
OpenCode-specific agents and command. Runtime state (factory/jobs, .worktrees)
is never copied. Existing project files are preserved: OpenCode settings are
merged into <project>/.opencode/opencode.json, AGENTS.md is only created when
absent, and custom agents/commands and .gitignore lines are kept.

Use --force to replace a previously installed factory's own files.
"""

import json
import shutil
import subprocess
import sys
from pathlib import Path

SOURCE = Path(__file__).resolve().parents[1]
COPY_FILES = [
    "factory/checks.sh",
    "factory/config.json",
    "factory/dashboard.html",
    "factory/install",
    "factory/labels",
    "factory/README.md",
]
COPY_DIRS = [
    "factory/bin",
    ".opencode/agents",
    ".opencode/commands",
]
MARKERS = [
    "factory/bin/job",
    "factory/config.json",
    ".opencode/commands/factory.md",
]
RUNTIME_IGNORES = ["/factory/jobs/", "/.worktrees/"]


def die(msg):
    print(f"install: {msg}", file=sys.stderr)
    sys.exit(1)


def load_json(path, label):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError) as e:
        die(f"cannot read {label}: {e}")


def is_repository(path):
    res = subprocess.run(["git", "-C", str(path), "rev-parse", "--git-dir"],
                         capture_output=True, text=True)
    return res.returncode == 0


def already_installed(target):
    return any((target / p).exists() for p in MARKERS)


def merge_settings(factory, existing):
    """Keep the project's settings while enforcing the factory's worktree."""
    merged = dict(existing)
    merged.setdefault("$schema", factory["$schema"])
    merged.setdefault("model", factory["model"])

    worktree = dict(existing.get("worktree") or {})
    worktree["directory"] = factory["worktree"]["directory"]
    merged["worktree"] = worktree

    required = {(r["action"], r.get("resource")): r
                for r in factory.get("permissions", []) if isinstance(r, dict)}
    rules = []
    for rule in existing.get("permissions", []):
        if not isinstance(rule, dict):
            rules.append(rule)
            continue
        if (rule.get("action"), rule.get("resource")) not in required:
            rules.append(rule)
    rules.extend(required.values())
    merged["permissions"] = rules
    return merged


def ensure_gitignore(target):
    path = target / ".gitignore"
    lines = path.read_text().splitlines() if path.exists() else []
    for entry in RUNTIME_IGNORES:
        if entry not in lines:
            lines.append(entry)
    path.write_text("\n".join(lines) + "\n")


def main(argv):
    force = "--force" in argv
    args = [a for a in argv if a != "--force"]
    if len(args) != 1:
        die(__doc__.strip())
    target = Path(args[0]).expanduser().resolve()
    if not target.is_dir():
        die(f"{target} is not a directory")
    if not is_repository(target):
        die(f"{target} is not a git repository")
    if already_installed(target) and not force:
        die("factory is already installed in that project; use --force to replace it")

    for rel in COPY_FILES:
        dst = target / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(SOURCE / rel, dst)
        if rel.startswith("factory/"):
            dst.chmod(0o755)
    for rel in COPY_DIRS:
        dst = target / rel
        shutil.copytree(SOURCE / rel, dst,
                        ignore=shutil.ignore_patterns("__pycache__", "*.pyc"),
                        dirs_exist_ok=True)

    agents_md = target / "AGENTS.md"
    if not agents_md.exists():
        shutil.copy2(SOURCE / "AGENTS.md", agents_md)
    ensure_gitignore(target)

    factory_settings = load_json(SOURCE / "opencode.json", "source opencode.json")
    root_config = target / "opencode.json"
    nested_config = target / ".opencode" / "opencode.json"
    settings_path = nested_config if (root_config.exists() or nested_config.exists()) else root_config
    if settings_path.exists():
        existing = load_json(settings_path, settings_path)
    elif settings_path != root_config and root_config.exists():
        existing = load_json(root_config, root_config)
    else:
        existing = {}
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    settings_path.write_text(json.dumps(merge_settings(factory_settings, existing), indent=2) + "\n")

    print(f"installed the OpenCode factory into {target}")
    print("next: factory/labels, then /factory run")


if __name__ == "__main__":
    main(sys.argv[1:])
